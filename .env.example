SUPABASE_CONNECTION_STRING=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Market data (personal/internal use only; verify provider terms before production)
MARKET_DATA_PROVIDER=none
TWELVE_DATA_API_KEY=
MARKET_DATA_BASE_URL=https://api.twelvedata.com
MARKET_DATA_MIC=XIDX
MARKET_DATA_LOOKBACK_DAYS=14

# Fundamentals/dividends: disabled by default because statement endpoints can consume significant API credits.
FUNDAMENTALS_PROVIDER=none
FUNDAMENTALS_BASE_URL=https://api.twelvedata.com
FUNDAMENTALS_MIC=XIDX
FUNDAMENTALS_LOOKBACK_YEARS=6
FUNDAMENTALS_OUTPUT_SIZE=6
FUNDAMENTALS_REQUEST_DELAY_MS=500
FUNDAMENTALS_CSV_DIRECTORY=database/seed/fundamentals
FUNDAMENTALS_CSV_FILE=fundamentals.csv
DIVIDENDS_CSV_FILE=dividends.csv
FUNDAMENTALS_INCLUDE_CASH_FLOW=true
FUNDAMENTALS_INCLUDE_BALANCE_SHEET=true
FUNDAMENTALS_INCLUDE_DIVIDENDS=true
